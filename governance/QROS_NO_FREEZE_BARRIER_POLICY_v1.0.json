{
  "schema": "QROS_NO_FREEZE_BARRIER_POLICY_1.0",
  "version": "v1.0",
  "date": "2026-09-18",
  "status": "ACTIVE_MANDATORY",
  "purpose": "Prevent user-visible freezes by making all heavy-job control interactions nonblocking, identity-bound and transactionally closeable.",
  "root_cause": "Exactly-once protected worker identity, and turn-commit protected narrative correctness, but chat orchestration still used blocking observation/wait loops. A control call could therefore hold the turn long enough to appear frozen or end before the next durable transition.",
  "hard_rules": {
    "max_control_call_seconds": 5,
    "deliberate_sleep_or_poll_wait_in_chat_forbidden": true,
    "unbounded_observation_forbidden": true,
    "prelaunch_durable_intent_required": true,
    "post_control_durable_state_required": true,
    "allowed_post_control_states": [
      "PASS",
      "RUNNING_ADOPTABLE",
      "FAIL_CLOSED",
      "PENDING_NOT_STARTED"
    ],
    "running_requires_durable_claim": true,
    "pass_or_fail_is_terminal_no_relaunch": true,
    "job_spec_semantic_drift_fail_closed": true,
    "supervisor_byte_drift_fail_closed": true,
    "second_expensive_unit_before_durable_close_forbidden": true,
    "commentary_may_not_claim_execution_before_launch_evidence": true
  },
