{
  "schema": "QROS_ANTI_FREEZE_EXECUTION_LAYER_1.0",
  "version": "v1.0",
  "date": "2026-09-19",
  "status": "ACTIVE_MANDATORY",
  "name": "QROS Anti-Freeze Execution Layer",
  "objective": "Guarantee bounded control-plane liveness: every execution block must produce verified progress, switch to a preregistered equivalent route, or persist a resumable safe state. Indefinite waiting/polling is forbidden.",
  "non_guarantee": "This layer cannot make unavailable infrastructure exist; it guarantees bounded non-stalling control flow, not guaranteed scientific success.",
  "root_cause": {
    "prior_architecture": "Point protections existed for exactly-once, call budgets, runtime fencing, manifest-first recovery and turn commit, but no single controller owned global progress and route abandonment.",
    "observed_failures": [
      "blocking synchronous heavy work",
      "runtime/boot migration while a unit is active",
      "repeated recovery discovery despite exact identifiers",
      "local runtime network denial for GitHub",
      "connector safety rejection on oversized/redundant control payloads",
      "CAS conflicts",
      "repeated status checks with no evidence delta",
      "fragmented policies allowing control-plane work to consume the turn"
    ]
  },
  "liveness_contract": {
    "checkpoint_call": 6,
    "hard_cap_calls": 8,
    "first_no_evidence_delta": "ONE_RECHECK_ALLOWED",
    "second_consecutive_no_evidence_delta": "CIRCUIT_BREAKER_ROUTE_SWITCH",
    "same_failed_route_reuse_in_same_block": false,
    "repair_patches_per_root_cause_per_block": 1,
    "heavy_work_sync": false,
    "heavy_work_launch": "NONBLOCKING_WITH_DURABLE_CLAIM",
    "deliberate_sleep": false,
    "polling_loop": false,
    "broad_search_when_exact_locator_exists": false,
    "local_network_dependency_for_repo_blobs": false,
    "max_expensive_units_open": 1,
    "artifact_first_resumption": true,
    "durable_close_required": true
  },
  "progress_fingerprint": [
    "authority_blob",
    "checkpoint_blob",
    "unit_id",
    "unit_state",
    "attempt",
    "lease_epoch",
    "artifact_root",
    "next_action"
  ],
  "evidence_delta_rule": "A control action is useful only if it changes the progress fingerprint, proves a new capability fact, creates a durable claim/receipt, or produces a durable root-cause certificate.",
  "route_priority": [
    "TERMINAL_RECEIPT_OR_EXACT_OUTPUTS",
    "CURRENT_RUNTIME_CLAIM_STATUS_ONCE",
    "FENCED_RUNTIME_CUTOVER_FOR_NON_ECONOMIC_FOREIGN_CLAIM",
    "DIRECT_MANIFEST_LOCATOR_MATERIALIZATION",
    "EXACT_GITHUB_CONNECTOR_BLOB_FETCH",
    "NONBLOCKING_EXACTLY_ONCE_LAUNCH",
    "DURABLE_BLOCKED_BY_INFRASTRUCTURE"
  ],
  "circuit_breakers": {
    "no_evidence_delta_repeat": 2,
    "route_failure_with_alternative": "SWITCH_IMMEDIATELY",
    "local_git_network_denied": "USE_GITHUB_CONNECTOR_EXACT_BLOB_FETCH",
    "connector_safety_block": "MINIMIZE_TO_REFERENCES_AND_HASHES_THEN_RETRY_ONCE",
    "cas_conflict": "REFRESH_AND_RECONCILE_ONCE_NO_OVERWRITE",
    "partial_output": "QUARANTINE_AND_VALIDATE_OR_REMATERIALIZE_SAME_UNIT",
    "foreign_runtime": "NO_LOCAL_PID_INFERENCE; FENCED_CUTOVER_ONLY_WHEN_ALLOWED",
    "call_budget": "CHECKPOINT_HAS_PRIORITY_OVER_OTHER_DIAGNOSTICS"
  },
  "anti_overengineering": {
    "no_build_while_current_route_is_runnable": true,
    "one_validated_repair_per_same_root_cause": true,
    "repeated_repair_without_new_evidence_forbidden": true,
    "new_control_plane_component_requires_fault_reproduction_and_regression_test": true
  },
